VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
# Optional comma-separated list of origins where Google button should render.
# Example: http://localhost:5173,https://myopiaguard.vercel.app
VITE_GOOGLE_ALLOWED_ORIGINS=
# Local default (frontend dev + local backend)
VITE_API_URL=http://localhost:5001
# Optional: separate auth backend base URL (used by Google login)
# Example: https://your-node-auth-service.example.com
VITE_AUTH_API_URL=
